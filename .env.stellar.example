# .env.stellar.example
# Copy to .env.stellar and fill in the values.
# Never commit .env.stellar to git.

# ── Stellar keypair ───────────────────────────────────────────────────────────
# Generate a new keypair: stellar keys generate --global binalyst-deployer
# Then export: stellar keys show binalyst-deployer
STELLAR_SECRET_KEY=S...

# ── Network ───────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── RISC Zero image_id ────────────────────────────────────────────────────────
# From `cargo risczero build` output in Session O.
# 64 hex chars (32 bytes). Example:
# BINALYST_IMAGE_ID=a1b2c3d4e5f6...
BINALYST_IMAGE_ID=

# ── Written automatically by deploy-verifier.sh ───────────────────────────────
STELLAR_CONTRACT_ID=
