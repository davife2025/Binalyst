# .env.stellar.example — Session Q additions
# Merge these into your existing .env.stellar.example / .env.local

# ── Stellar (from Session P) ──────────────────────────────────────────────────
STELLAR_SECRET_KEY=S...
STELLAR_CONTRACT_ID=C...
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ── RISC Zero host binary ──────────────────────────────────────────────────────
# Path to the compiled binalyst-zk-host binary.
# Build: cargo build --release -p binalyst-zk-host
ZK_HOST_BIN=./target/release/binalyst-zk-host

# ── Development modes ──────────────────────────────────────────────────────────
# Set both to 'mock' / 'true' for UI development before Rust + Stellar are ready.
# Set to 'real' / 'false' for testnet integration.
ZK_PROVER_MODE=mock     # 'real' | 'mock'
STELLAR_MOCK=true       # 'true' | 'false'
