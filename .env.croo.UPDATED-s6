# ──────────────────────────────────────────────────────────────────────────────
# CROO Agent Protocol (CAP) — Environment Variables
# Add these to your existing .env.local
# ──────────────────────────────────────────────────────────────────────────────

# Your Vercel deployment URL (no trailing slash)
# Used to build CAP endpoint URLs in the manifest
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# CROO Agent Store listing ID
# Obtained after listing on https://agent.croo.network
NEXT_PUBLIC_CROO_AGENT_ID=binalyst-trading-agent

# BSCScan API key for on-chain payment verification
# Free at https://bscscan.com/register
BSCSCAN_API_KEY=your_bscscan_api_key

# Anthropic API key — used by /api/cap/submission to generate DoraHacks writeup
# Already required by other parts of Binalyst (chat, strategy, etc.)
ANTHROPIC_API_KEY=sk-ant-...

# ── Already in your .env.local (no change needed) ─────────────────────────────
# AGENT_WALLET_ADDRESS  — the agent's BSC wallet (receives USDC payments)
# AGENT_PRIVATE_KEY     — used only for trade_execute service (never logged)

# ── Session 6 additions ────────────────────────────────────────────────────────

# Max USDC auto-payment per CAP call (safety cap, default $5)
CAP_MAX_PAYMENT_USDC=5

# BSCScan API key (free at bscscan.com/register)
# Used for payment verification in /api/cap/invoke
BSCSCAN_API_KEY=your_bscscan_api_key_here
