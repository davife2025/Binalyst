# Binalyst — Sui Autonomous Agent Wallet
# Sui Overflow 2026 · Agentic Web Track · Sub-track 2
#
# These are ADDITIONS for the Sui agent module.
# They are independent of all existing env vars — add these alongside your
# existing .env.local. Do NOT replace anything already there.
#
# Existing vars (BNB/Binance, Celo, Mantle, Supabase, etc.) are untouched.

# ── Network ───────────────────────────────────────────────────────────────────

# Network to run the Sui agent on: 'testnet' (default for hackathon) or 'mainnet'
# IMPORTANT: use testnet until you are ready to go live.
# Testnet faucet: https://docs.sui.io/guides/developer/getting-started/get-coins
SUI_AGENT_NETWORK=testnet

# ── Move Policy Package ───────────────────────────────────────────────────────

# Package ID from deploying move/sources/agent_policy.move.
# Set this after running: cd move && sui client publish --gas-budget 100000000
# The package ID is in the publish output under "Published Objects".
# Leave blank to run in dry-run simulation mode (no on-chain policy enforcement).
NEXT_PUBLIC_POLICY_PACKAGE_ID=

# ── Walrus Memory (optional) ──────────────────────────────────────────────────

# MemWal API key for writing agent decisions to on-chain Walrus memory.
# Get your key at: https://docs.memwal.ai/ (create account → delegate key)
# Leave blank to skip Walrus memory writes (on-chain Move events still log all activity).
MEMWAL_API_KEY=
MEMWAL_API_URL=https://api.memwal.ai

# ── DeepBook (optional overrides) ────────────────────────────────────────────

# Override the default testnet DeepBook registry object ID if you are using
# a custom deployment or the official ID has changed.
# Default: uses the hardcoded testnet pool IDs in lib/deepbook/client.ts
# DEEPBOOK_REGISTRY_ID=

# ── Sui RPC overrides (optional) ─────────────────────────────────────────────

# Override the default public Sui RPC endpoints for better reliability.
# Leave blank to use the official public nodes (suitable for testnet demo).
# SUI_RPC_MAINNET=https://sui-mainnet.g.alchemy.com/v2/YOUR_KEY
# SUI_RPC_TESTNET=https://sui-testnet.g.alchemy.com/v2/YOUR_KEY

# ── How to deploy the Move package ───────────────────────────────────────────
#
# 1. Install the Sui CLI:
#    https://docs.sui.io/guides/developer/getting-started/sui-install
#
# 2. Configure testnet:
#    sui client switch --env testnet
#    sui client faucet     (get testnet SUI for gas)
#
# 3. Publish the package:
#    cd move
#    sui client publish --gas-budget 100000000
#
# 4. Copy the package ID from the output and set it above.
#
# 5. Or use the automated deploy script:
#    bash scripts/deploy-sui.sh
#    (writes NEXT_PUBLIC_POLICY_PACKAGE_ID to .env.local automatically)
