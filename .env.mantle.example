# Mantle AI Trading Agent — Session N1
#
# These are ADDITIONS for the Mantle agent module (The Turing Test Hackathon).
# They are independent of all existing env vars — add these alongside your
# existing .env.local, do NOT replace anything already there.
#
# Existing vars (BNB/Binance, Celo, Sui, Supabase, etc.) are untouched.

# ── Network ──────────────────────────────────────────────────────────────────

# Network to run the Mantle agent on: 'testnet' (Mantle Sepolia, default) or 'mainnet'
# IMPORTANT: use testnet until you are ready to go live — mainnet requires real MNT.
MANTLE_AGENT_NETWORK=testnet

# ── Wallet ───────────────────────────────────────────────────────────────────

# Private key for the Mantle agent's self-custodial wallet.
# Generate one with generateMantleWallet() from lib/mantle/client.ts:
#   import { generateMantleWallet } from '@/lib/mantle/client'
#   const w = generateMantleWallet()
#   console.log(w.address, w.privateKey)
#
# Fund the address:
#   Testnet (Mantle Sepolia): https://faucet.sepolia.mantle.xyz
#   Mainnet: bridge MNT from Ethereum via https://bridge.mantle.xyz
#
# SECURITY: This key controls real funds on mainnet. Never commit it.
MANTLE_AGENT_PRIVATE_KEY=

# ── Bybit API (optional — market data only, no trading key needed) ───────────

# Bybit market data is used via the public REST API (no auth required).
# If you have a Bybit API key, set it here to access higher rate limits.
# Leave blank to use the public (unauthenticated) endpoint.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── RPC overrides (optional) ─────────────────────────────────────────────────

# Override the default Mantle RPC endpoints if you have your own node or
# an Alchemy/Infura/QuickNode API key for better reliability.
# MANTLE_RPC_MAINNET=https://mantle-mainnet.g.alchemy.com/v2/YOUR_KEY
# MANTLE_RPC_TESTNET=https://mantle-sepolia.g.alchemy.com/v2/YOUR_KEY

# ── ERC-8004 (optional — filled automatically by the Register Agent button) ──

# Set by the UI after registration — do not fill manually.
# MANTLE_AGENT_ID=
# MANTLE_AGENT_REGISTRATION_TX=
