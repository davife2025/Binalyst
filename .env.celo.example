# Celo Payments Agent — Session J
#
# These are ADDITIONS for the Celo agent module. They are independent of
# any existing BNB/Binance/TWAK env vars — add these alongside, don't
# replace anything in your existing .env / .env.local.

# Network to run the Celo agent on: 'alfajores' (testnet, default) or 'mainnet'
CELO_AGENT_NETWORK=alfajores

# Private key for the Celo agent's wallet (separate from the BNB agent wallet).
# Generate one with generateCeloWallet() from lib/celo/client.ts, or use
# Alfajores faucet: https://faucet.celo.org/alfajores
CELO_AGENT_PRIVATE_KEY=

# Optional: override default RPCs if you have your own node / API key
# CELO_RPC_MAINNET=
# CELO_RPC_ALFAJORES=
